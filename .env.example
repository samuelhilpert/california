# Firebase-Webkonfiguration (Firebase Console → Projekteinstellungen → Deine Apps → Web-App).
# Diese Werte sind nicht geheim; der Schutz der Daten erfolgt über Login + firestore.rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# ID des gemeinsamen Fahrtenbuchs (optional, Standard: california)
VITE_BOOK_ID=california
